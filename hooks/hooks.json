{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|ApplyPatch|Bash|mcp__(plugin_)?unica(_unica)?__.*)$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/unica_source_gate.py"
            ],
            "timeoutMs": 10000,
            "statusMessage": "1c-zcode: гейт исходников Unica"
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|ApplyPatch|mcp__(plugin_)?unica(_unica)?__.*)$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/doc_gate.py"
            ],
            "timeoutMs": 10000,
            "statusMessage": "1c-zcode: гейт «документация до решения»"
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__1c-testpilot__.*|mcp__1c-db__.*)$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/mcp_gate.py"
            ],
            "timeoutMs": 10000,
            "statusMessage": "1c-zcode: прод-гейт тест-контура"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/retry_gate.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "1c-zcode: дисциплина ретраев"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_)?unica(_unica)?__.*$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/unica_source_gate.py"
            ],
            "timeoutMs": 5000
          },
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/doc_gate.py"
            ],
            "timeoutMs": 5000
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/retry_gate.py"
            ],
            "timeoutMs": 5000
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|ApplyPatch)$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/bsl_style_gate.py"
            ],
            "timeoutMs": 45000,
            "statusMessage": "1c-zcode: стайл-чек BSL"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/retry_gate.py"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_clean.py"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
