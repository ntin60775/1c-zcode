* text=auto
*.htm text eol=crlf
*.html text eol=crlf

*.bsl text eol=crlf
*.os text eol=crlf

*.xml text eol=crlf
*.feature text
*.md text
*.json text

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
*.groovy text eol=lf
# Двоичные .bin — поимённо, классом нельзя: XDTO Package.bin текстовый
# (unica.check: git.text_resource_marked_binary), а Template.bin — бинарный
# макет (git.binary_policy_missing без правила)
Form.bin binary
Template.bin binary
ParentConfigurations.bin binary

# Растровые ресурсы выгрузки: все форматы, иначе unica.check ругается
# git.binary_policy_missing (встречался .bmp в формах)
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.tif binary
*.tiff binary
*.webp binary

# Архивы
*.7z binary
*.gz binary
*.tar binary
*.tgz binary
*.zip binary

*.cf binary
*.cfe binary
*.epf binary
*.erf binary
ParentConfigurations.bin binary
